{
  "name": "homepet-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:api\" \"npm:web\"",
    "web": "vite",
    "api": "json-server db.json --port 3001 --watch",
    "build": "vite build",
    "preview": "vite preview",
    "restaurar-datos": "node -e \"require('fs').copyFileSync('db.inicial.json','db.json')\""
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "json-server": "^0.17.4",
    "vite": "^8.3.4"
  }
}
